# Los archivos que terminan dentro de imagenes Linux se guardan siempre con LF, aunque Git para
# Windows tenga core.autocrlf=true: con CRLF, "#!/bin/bash\r" no ejecuta y MariaDB aborta la
# inicializacion de las bases (ver ERRORES.md, api-pagos error 3).
*.sh         text eol=lf
*.sql        text eol=lf
*.conf       text eol=lf
Dockerfile   text eol=lf
.dockerignore text eol=lf
env.example  text eol=lf

# Estadistica de lenguajes de GitHub (Linguist): por defecto ignora los archivos de datos y de
# configuracion. Aca la configuracion es codigo de infraestructura del proyecto (docker-compose.yml
# y nginx.conf), asi que se la incluye para que la barra de lenguajes refleje el repo.
*.yml        linguist-detectable
*.conf       linguist-detectable linguist-language=Nginx
