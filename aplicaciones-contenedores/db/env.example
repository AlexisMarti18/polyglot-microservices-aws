# Copiar este archivo a ".env" y completar valores (no commitear el .env con contraseñas reales)
MYSQL_ROOT_PASSWORD=
# Esta es la "principal": la crea automaticamente la imagen oficial de MariaDB.
# Las otras 4 bases (una por microservicio) las crea el script 00-databases.sh
MYSQL_DATABASE=db_clientes
# Usuario "de aplicacion" compartido por los 5 microservicios (cada uno solo entra a SU base)
MYSQL_USER=
MYSQL_PASSWORD=
