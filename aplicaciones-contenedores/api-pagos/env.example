# Copiar a ".env" y completar. DB_HOST tiene que ser el nombre del contenedor de la DB compartida.
# En docker-compose.yml ese servicio se llama "db".
DB_HOST=db
DB_PORT=3306
DB_NAME=db_pagos
# Mismos valores que MYSQL_USER / MYSQL_PASSWORD de ../db/.env (usuario de aplicacion compartido)
DB_USER=
DB_PASSWORD=
PORT=8080
